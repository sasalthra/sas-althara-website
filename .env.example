# Copy to .env.local locally. Never commit actual secrets.
# Use the temporary HTTPS app URL first, with no trailing slash.
NEXTAUTH_URL=
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# Enable for remote MySQL with a valid TLS certificate.
DB_SSL=false
# Optional Hostinger mailbox SMTP for CRM assignment emails.
# If unset, assignments still save and emails are skipped.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
