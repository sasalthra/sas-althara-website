# Copy to .env.local locally. Never commit actual secrets.
# Use the temporary HTTPS app URL first, with no trailing slash.
NEXTAUTH_URL=
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# Enable for remote MySQL with a valid TLS certificate.
DB_SSL=false
# Optional Gmail SMTP for CRM assignment emails (not the company info@ mailbox).
# If host/user/password are unset, assignments still save and emails are skipped.
# SMTP_PASSWORD must be a Google App Password, never the Gmail account password.
# SMTP_PORT=465 (set SMTP_SECURE=true) or 587 (set SMTP_SECURE=false).
# Leave SMTP_FROM empty to use the code default: ساس الثراء <sasalthra.sa@gmail.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sasalthra.sa@gmail.com
SMTP_PASSWORD=
SMTP_FROM=sasalthra.sa@gmail.com
